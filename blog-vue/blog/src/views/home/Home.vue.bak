<script>
import Swiper from "../../components/Swiper.vue";
import EasyTyper from "easy-typer-js";
import MarkdownIt from "markdown-it";

const md = new MarkdownIt();

export default {
  components: {
    Swiper
  },
  created() {
    this.init();
    this.listHomeTalks();
    this.fetchClawdchatPosts();
    this.timer = setInterval(this.runTime, 1000);
    // this.initMoyuPic();
  },
  data: function () {
    return {
      tip: false,
      time: "",
      obj: {
        output: "",
        isEnd: false,
        speed: 300,
        singleBack: false,
        sleep: 0,
        type: "rollback",
        backSpeed: 40,
        sentencePause: true
      },
      articleList: [],
      moyuPic: "../../../public/img/wanma.png",
      talkList: [],
      clawdchatPosts: [],
      current: 1
    };
  },

  methods: {
    fetchClawdchatPosts() {
      this.axios.get("/clawdchat-api/api/v1/agents/98b5c397-c5bc-423a-9049-6663409d0467/posts?limit=3&skip=0")
        .then(({data}) => {
          if (data && data.posts) {
            this.clawdchatPosts = data.posts;
          }
        }).catch(() => {});
    },
    // 初始化
    async init() {
      // 假设blogInfo已经在data中定义
      if (this.blogInfo && this.blogInfo.websiteConfig) {
        document.title = this.blogInfo.websiteConfig.websiteName;
      }
      // 使用async/await进行异步请求
      this.axios.get("/api/talks/first").then(({data}) => {
        this.initTyped(data.data);
      });

      // // 一言Api进行打字机循环输出效果
      // fetch("https://v1.hitokoto.cn?c=i")
      //   .then(res => {
      //     return res.json();
      //   })
      //   .then(({hitokoto}) => {
      //     this.initTyped(hitokoto);
      //   });
    },
    listHomeTalks() {
      this.axios.get("/api/home/talks").then(({data}) => {
        this.talkList = data.data;
      });
    },
    initTyped(input, fn, hooks) {
      const obj = this.obj;
      // eslint-disable-next-line no-unused-vars
      const typed = new EasyTyper(obj, input, fn, hooks);
    },
    scrollDown() {
      window.scrollTo({
        behavior: "smooth",
        top: document.documentElement.clientHeight
      });
    },
    runTime() {
      var timeold =
          new Date().getTime() -
          new Date(this.blogInfo.websiteConfig.websiteCreateTime).getTime();
      var msPerDay = 24 * 60 * 60 * 1000;
      var daysold = Math.floor(timeold / msPerDay);
      var str = "";
      var day = new Date();
      str += daysold + "天";
      str += day.getHours() + "时";
      str += day.getMinutes() + "分";
      str += day.getSeconds() + "秒";
      this.time = str;
    },
    // async initMoyuPic() {
    //   await this.axios
    //       .get("https://api.vvhan.com/api/moyu", {
    //         params: {
    //         type: "json"
    //         }
    //       })
    //       .then(({data}) => {
    //         this.moyuPic = data.url;
    //       });
    // },
    preview() {
      let pic_images = [this.moyuPic];
      this.$imagePreview({
        showIndex: true,
        loop: false,
        images: pic_images,
        index: 0
      });
    },
    infiniteHandler($state) {
      this.axios
          .get("/api/articles", {
            params: {
              current: this.current
            }
          })
          .then(({data}) => {
            if (data.data.length) {
              // 去除markdown标签
              data.data.forEach(item => {
                item.articleContent = md
                    .render(item.articleContent)
                    .replace(/<\/?[^>]*>/g, "")
                    .replace(/[|]*\n/, "")
                    .replace(/&npsp;/gi, "");
              });
              this.articleList.push(...data.data);
              this.current++;
              $state.loaded();
            } else {
              $state.complete();
            }
          });
    }

  },
  metaInfo: {
    meta: [{
      name: "keyWords",
      content: "超伟博客,开源博客,www.macw.cc"  //变量或字符串
    }, {
      name: "description",
      content: "一个专注于技术分享的博客平台,大家以共同学习,乐于分享,拥抱开源的价值观进行学习交流"
    }]
  },
  mounted: async function () {
    // 设置配置信息
    window.WIDGET = {
      CONFIG: {
        layout: "2",
        width: 230,
        height: 300,
        background: "2",
        dataColor: "000000",
        borderRadius: "5",
        city: "CN101180101",
        key: "4034255d0cc94897b5f745367ccb81f2"
      }
    };

    // 异步加载脚本
    let script = document.createElement("script");
    script.type = "text/javascript";
    script.src = "https://widget.qweather.net/standard/static/js/he-standard-common.js?v=2.0";
    script.async = true; // 设置async属性

    // 监听加载完成事件
    script.onload = function () {
      // 脚本加载完成后执行的代码，如果有需要的话
      console.log('QWeather script loaded');
    };

    // 错误处理
    script.onerror = function (error) {
      console.error('QWeather script loading failed:', error);
    };

    // 将脚本添加到head中
    document.getElementsByTagName("head")[0].appendChild(script);
  },
  computed: {
    isRight() {
      return function (index) {
        if (index % 2 == 0) {
          return "article-cover left-radius";
        }
        return "article-cover right-radius";
      };
    },
    blogInfo() {
      return this.$store.state.blogInfo;
    },
    isShowSocial() {
      return function (social) {
        var list = this.blogInfo.websiteConfig.socialUrlList;
        return list && list.indexOf(social) != -1;
      };
    },
    cover() {
      var cover = "";
      this.$store.state.blogInfo.pageList.forEach(item => {
        if (item.pageLabel == "home") {
          cover = item.pageCover;
        }
      });
      return "background: url(" + cover + ") center center / cover no-repeat";
    }
  }
};
</script>

